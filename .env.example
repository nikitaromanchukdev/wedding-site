# Public config (inlined into the client bundle — no secrets here).
# Copy to .env.local and fill in real values.

# RSVP call-to-action target (Telegram invite, Google Form viewform URL, etc.).
# Server-only (no NEXT_PUBLIC_) — resolved by the /go/rsvp redirect, kept out of the client bundle.
RSVP_URL=

# Google Form direct submission (only needed if the inline RSVP form is enabled).
# Form ID: the long string in https://docs.google.com/forms/d/e/{FORM_ID}/viewform
NEXT_PUBLIC_GOOGLE_FORM_ID=
# entry.XXXXX ids for each field (view the form source / prefill URL to find them).
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_NAME=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_ATTENDING=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_MESSAGE=
